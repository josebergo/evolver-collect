@page "/alarms"
@rendermode InteractiveServer
@inject ConfigRepository Repo

<h1>报警</h1>
<p class="page-sub">报警规则与实时报警将在 v0.3（M3 里程碑）上线：阈值/开关位/变化触发、防抖、恢复通知。当前可查看历史记录。</p>

<h2>报警历史</h2>
<table class="table">
    <thead><tr><th>时间</th><th>规则</th><th>设备/点位</th><th>级别</th><th>触发值</th><th>恢复时间</th></tr></thead>
    <tbody>
        @foreach (var a in _history)
        {
            <tr>
                <td class="cell-time">@a.TriggeredAt.ToString("MM-dd HH:mm:ss")</td>
                <td>@a.RuleName</td>
                <td>@a.DeviceName / @a.TagName</td>
                <td><span class="badge @(a.Level >= 3 ? "badge-bad" : a.Level == 2 ? "badge-warn" : "badge-muted")">@LevelText(a.Level)</span></td>
                <td class="cell-value">@a.TriggerValue</td>
                <td>@(a.RecoveredAt?.ToString("MM-dd HH:mm:ss") ?? "-")</td>
            </tr>
        }
        @if (_history.Count == 0)
        {
            <tr><td colspan="6" class="empty">暂无记录</td></tr>
        }
    </tbody>
</table>

@code {
    private List<AlarmHistoryEntity> _history = [];

    protected override async Task OnInitializedAsync() =>
        _history = await Repo.QueryAlarmHistoryAsync(null, null, 200);

    private static string LevelText(int level) => level switch { 3 => "严重", 2 => "警告", _ => "提示" };
}
