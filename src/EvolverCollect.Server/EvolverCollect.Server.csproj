<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Evolver Collect 宿主：Minimal API + Blazor 控制台 + SignalR 实时推送 + 内置文档中心</Description>
    <RootNamespace>EvolverCollect.Server</RootNamespace>
    <AssemblyName>evolver-collect</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EvolverCollect.Core\EvolverCollect.Core.csproj" />
    <ProjectReference Include="..\EvolverCollect.Storage\EvolverCollect.Storage.csproj" />
    <ProjectReference Include="..\EvolverCollect.Drivers.Modbus\EvolverCollect.Drivers.Modbus.csproj" />
    <ProjectReference Include="..\EvolverCollect.Drivers.OpcUa\EvolverCollect.Drivers.OpcUa.csproj" />
    <ProjectReference Include="..\EvolverCollect.Northbound.Mqtt\EvolverCollect.Northbound.Mqtt.csproj" />
    <ProjectReference Include="..\EvolverCollect.Drivers.Mc\EvolverCollect.Drivers.Mc.csproj" />
    <ProjectReference Include="..\EvolverCollect.Drivers.Fins\EvolverCollect.Drivers.Fins.csproj" />
    <ProjectReference Include="..\EvolverCollect.Drivers.S7\EvolverCollect.Drivers.S7.csproj" />
    <ProjectReference Include="..\EvolverCollect.Northbound.Kafka\EvolverCollect.Northbound.Kafka.csproj" />
    <ProjectReference Include="..\EvolverCollect.Drivers.Focas\EvolverCollect.Drivers.Focas.csproj" />
    <ProjectReference Include="..\EvolverCollect.Northbound.Database\EvolverCollect.Northbound.Database.csproj" />
    <ProjectReference Include="..\EvolverCollect.Northbound.Http\EvolverCollect.Northbound.Http.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.*" />
    <PackageReference Include="Markdig" Version="0.4*" />
    <PackageReference Include="MiniExcel" Version="1.3*" />
  </ItemGroup>

  <!-- 内置文档中心：docs/ 内容以嵌入资源打进 exe，现场完全离线可查（proposal 等设计文档不打进去） -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\**\*.md" LinkBase="docs" Exclude="..\..\docs\proposal*.md" />
  </ItemGroup>

</Project>
