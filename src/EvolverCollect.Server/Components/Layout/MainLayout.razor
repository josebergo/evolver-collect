@inherits LayoutComponentBase

<div class="shell">
    <aside class="sidebar">
        <div class="brand">
            <span class="brand-mark">EC</span>
            <div class="brand-text">
                <strong>Evolver Collect</strong>
                <small>设备数据采集网关</small>
            </div>
        </div>
        <nav class="nav">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All"> 总览</NavLink>
            <NavLink class="nav-link" href="channels"> 采集通道</NavLink>
            <NavLink class="nav-link" href="devices"> 设备管理</NavLink>
            <NavLink class="nav-link" href="tags"> 点位与实时值</NavLink>
            <NavLink class="nav-link" href="north-apps"> 北向转发</NavLink>
            <NavLink class="nav-link" href="alarms"> 报警</NavLink>
            <NavLink class="nav-link" href="docs"> 文档中心</NavLink>
            <NavLink class="nav-link" href="settings"> 设置</NavLink>
        </nav>
        <div class="sidebar-footer">
            <AuthorizeView>
                <Authorized>
                    <span class="user">@context.User.Identity?.Name</span>
                    <a class="btn btn-ghost btn-sm" href="/logout">退出</a>
                </Authorized>
            </AuthorizeView>
        </div>
    </aside>
    <main class="main">
        @Body
    </main>
</div>
